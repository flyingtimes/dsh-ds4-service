{
  "name": "dsh-ds4-service",
  "version": "0.1.0",
  "description": "DeepSeek Harness DS4 服务控制插件：在 Web GUI 里开启/重启/关闭 ds4-server，并可视化配置 start.sh 的全部参数。插件自带 ds4-server 二进制与启动脚本。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "config.example.json",
    "config.json",
    "assets",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clarkchan/dsh-ds4-service.git"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ds4",
    "llm",
    "server",
    "service-control"
  ]
}
